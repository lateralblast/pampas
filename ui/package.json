{
  "name": "pampas-ui",
  "private": true,
  "version": "0.5.5",
  "type": "module",
  "description": "Front end of the pampas desktop app: plain HTML, CSS and TypeScript, no framework",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
